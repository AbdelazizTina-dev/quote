# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode: sk_test_...). Webhook secret is optional in dev —
# the success redirect verifies payments; the webhook is the production path.
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Postmark for sending quote emails + notifications (optional in dev —
# without it, "Email to client" explains itself and notifications no-op)
# POSTMARK_SERVER_TOKEN=your-postmark-server-token
# EMAIL_FROM=quotes@yourdomain.com

# Public base URL used in emailed links (defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app

# Optional: default email for `npm run login`
# DEV_LOGIN_EMAIL=you@example.com
