# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode: sk_test_...). Webhook secrets are optional in dev —
# success redirects verify sessions; webhooks are the production path.
# STRIPE_WEBHOOK_SECRET: endpoint listening to connected accounts (deposits)
# STRIPE_WEBHOOK_SECRET_PLATFORM: endpoint for platform events (subscriptions)
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_SECRET_PLATFORM=whsec_...

# Resend for sending quote emails + notifications (optional in dev —
# without it, "Email to client" explains itself and notifications no-op)
# RESEND_API_KEY=re_...
# Defaults to Resend's shared test sender, which only delivers to the
# address that owns the Resend account. Set this once a domain is verified.
# EMAIL_FROM=Your Business <quotes@yourdomain.com>

# Public base URL used in emailed links (defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app

# Optional: default email for `npm run login`
# DEV_LOGIN_EMAIL=you@example.com
